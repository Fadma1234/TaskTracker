# Convex deployment URL used by the Vite frontend.
# Local development usually uses http://127.0.0.1:3210.
# Production should use your Convex cloud URL, such as https://your-app.convex.cloud.
VITE_CONVEX_URL=

# Server-side AI configuration belongs in Convex environment variables,
# not in the browser-facing Vite environment.
# Set these with:
# npx convex env set OPENAI_API_KEY your_key
# npx convex env set OPENAI_MODEL gpt-4o-mini
